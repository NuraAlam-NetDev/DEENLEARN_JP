{
  "name": "deenlearn",
  "private": true,
  "version": "0.1.0",
  "description": "Deenlearn - Islamic learning platform (MERN monorepo)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "npm run lint -w server && npm run lint -w client"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "dependencies": {
    "i18next": "^26.4.3",
    "nodemailer": "^10.1.0",
    "react-i18next": "^17.0.16"
  }
}
