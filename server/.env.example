# Copy this file to server/.env and fill in the values. Never commit .env.

# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser addresses
CLIENT_ORIGIN=http://localhost:5173
# Where the React app lives (used in emails and payment redirects)
CLIENT_URL=http://localhost:5173
# Public address of this API (payment providers call it back)
PUBLIC_API_URL=http://localhost:5000

# ---- Database ----
# MongoDB Atlas: Atlas -> Connect -> Drivers. Keep the database name (deenlearn).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/deenlearn

# ---- Auth ----
# Two DIFFERENT long random secrets. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# lax works when client and API share a site (dev proxy / same domain).
# Use "none" only when they are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax

# ---- Files (Cloudinary) ----
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
MAX_FILE_MB=25

# ---- Payments ----
# Stripe test key (sk_test_...) and webhook signing secret (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (forgot password and payment results) ----
# Leave SMTP_HOST empty to only print emails in the server console (local testing).
# Brevo example: smtp-relay.brevo.com / 587 / your login email / SMTP key / verified sender
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
